# 本地大模型（Ollama）
GM_OLLAMA_URL=http://localhost:11434
# 留空则自动选择：qwen3.8:27b-mlx > qwen3:27b > qwen2.5:14b > qwen2.5:7b ...
GM_OLLAMA_MODEL=
GM_LLM_TIMEOUT=120

# 产品与租户
GM_TENANT=starsea
GM_GAME_NAME=《星海纪元》

# ROI 测算默认假设
GM_MENTOR_HOURLY=120
GM_OJT_MINUTES=25

